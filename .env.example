# Copie ce fichier en .env.local (gitignoré, jamais commité) et remplis les valeurs.
# .env (versionné) contient déjà les valeurs par défaut de dev qui ne sont pas des secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL 5.7, cf. README.md
DATABASE_URL=mysql://root:root@127.0.0.1:3306/binioufous_4?serverVersion=5.7
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# DSN du transport SMTP. Exemple pour une boîte mail OVH (offre "Emails" liée
# au nom de domaine, host/port trouvés dans l'espace client OVH > Emails) :
# MAILER_DSN=smtp://EMAIL_ENCODE%40:MOT_DE_PASSE@ssl0.ovh.net:465
# Le "@" de l'email s'encode en %40 dans l'URL. Sans cette variable, l'appli
# démarre quand même (le DSN n'est résolu qu'au moment d'un envoi réel), mais
# aucun email (contact, inscription, validation) ne part.
MAILER_DSN=

# Adresse utilisée comme expéditeur/destinataire des emails de contact, et
# comme expéditeur des emails d'inscription/validation. Doit être la même
# boîte mail que celle utilisée dans MAILER_DSN (les serveurs SMTP mutualisés
# type OVH refusent souvent un "from" qui n'est pas la boîte authentifiée).
CONTACT_EMAIL=
###< symfony/mailer ###
