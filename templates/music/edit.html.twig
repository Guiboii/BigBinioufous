{% extends 'base.html.twig' %}

{% block title %}{{ 'music.edit_title'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'music.edit_heading'|trans }}</h1>

    {{ include('music/_form.html.twig', {button_label: 'music.update_submit'}) }}

    <h2>{{ 'music.voices_heading'|trans }}</h2>

    <ul>
        {% for voice in track.voices %}
            <li>
                {{ voice.name }}
                {% if voice.filename %}
                    <a href="{{ asset('uploads/music/voices/' ~ voice.filename) }}">{{ 'music.voice_listen'|trans }}</a>
                {% endif %}
                <form method="post" action="{{ path('voice_delete', {trackId: track.id, voiceId: voice.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'music.confirm_delete_voice'|trans|e('js') }}');">
                    <input type="hidden" name="_method" value="DELETE">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_voice' ~ voice.id) }}">
                    <button class="btn btn-sm">{{ 'music.delete'|trans }}</button>
                </form>
            </li>
        {% else %}
            <li>{{ 'music.no_voices'|trans }}</li>
        {% endfor %}
    </ul>

    {{ form_start(voiceForm) }}
    <div class="form-group">
        {{ form_widget(voiceForm) }}
        <button type="submit" class="btn btn-dark">{{ 'music.voice_add_submit'|trans }}</button>
    </div>
    {{ form_end(voiceForm) }}

    <a href="{{ path('music') }}">{{ 'music.back_to_list'|trans }}</a>

    {{ include('music/_delete_form.html.twig') }}
{% endblock %}
