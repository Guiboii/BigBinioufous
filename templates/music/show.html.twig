{% extends 'base.html.twig' %}

{% block title %}{{ 'music.track_title'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'music.track_title'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th scope="row">{{ 'Id'|trans }}</th>
                <td>{{ track.id }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'music.artist'|trans }}</th>
                <td>{{ track.artist ? track.artist.name : '' }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'Title'|trans }}</th>
                <td>{{ track.title }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'music.duration'|trans }}</th>
                <td>{{ track.minutes }}'{{ track.seconds }}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('music') }}">{{ 'music.back_to_list'|trans }}</a>

    <a href="{{ path('track_edit', {id: track.id}) }}">{{ 'music.edit_link'|trans }}</a>

    {{ include('music/_delete_form.html.twig') }}
{% endblock %}
