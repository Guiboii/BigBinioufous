{% extends 'base.html.twig' %}

{% block importmap %}
    {# Sur petit écran, le meuble 3D + le personnage deviennent minuscules et
       la scène mange toute la place utile : plutôt que rediriger vers une
       autre page (cas /story, qui a un vrai contenu dupliqué en iframe),
       music.js lit cette classe et saute entièrement l'init Three.js
       (canvas/GLTF/resize 3D) ; le lecteur (Player.js, indépendant du 3D)
       et la playlist restent affichés en flux normal, cf. music.css. Posée
       avant le 1er rendu pour éviter un flash. #}
    <script>
        document.documentElement.classList.add(window.matchMedia('(max-width: 700px)').matches ? 'is-mobile' : 'is-desktop');
    </script>
    {{ importmap(['app', 'music']) }}
{% endblock %}

{% block title %}{{ 'music.title'|trans }}
{% endblock %}

{% block body %}

    <h1 class="sr-only">{{ 'music.title'|trans }}</h1>

    <p class="mobile-note">{{ 'music.mobile_note'|trans }}</p>

    <div class="overlay">
        <div class="player-wrap">
            <div class="row">

                <div class="waveW">
                    <div id="waveform"></div>
                </div>
            </div>
            <div
                class="row playerButtons" role="region" aria-label="{{ 'music.player_region'|trans }}">
                {# <a href="{{ path('track_new') }}">Upload</a> #}
                {% if app.user %}
                    <a id="uploadNew" href="new">
                        <span id="upload">
                            <svg class="bi bi-circle-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
                            {{ 'music.upload'|trans }}</span>
                    </a>
                {% endif %}

                {# Avant : <div id="stopTrack">/<div id="playPause">/<div id="loopRegion">
                   avec juste un handler "click" (assets/music/Player.js), donc
                   inatteignables et inactivables au clavier, sans nom accessible
                   (icône seule). De vrais <button> : le clic clavier (Entrée/
                   Espace) déclenche déjà l'événement "click" écouté par
                   Player.js, aucun changement JS de handler nécessaire pour ça.
                   aria-label posé ici en solde/repli ; Player.js le met à jour
                   dynamiquement pour Lecture/Pause selon l'état réel. #}
                <button type="button" id="stopTrack" class="player-btn" aria-label="{{ 'music.stop_label'|trans }}">
                    <span id="stop" aria-hidden="true">
                        <svg class="bi bi-stop-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M5 3.5h6A1.5 1.5 0 0112.5 5v6a1.5 1.5 0 01-1.5 1.5H5A1.5 1.5 0 013.5 11V5A1.5 1.5 0 015 3.5z"/></svg>
                    </span>
                </button>

                {# data-play-label/data-pause-label : lus par Player.js pour tenir
                   l'aria-label à jour selon l'état lecture/pause réel (les
                   traductions restent en Twig, pas codées en dur en JS). #}
                <button type="button" id="playPause" class="player-btn" aria-label="{{ 'music.play_label'|trans }}" data-play-label="{{ 'music.play_label'|trans }}" data-pause-label="{{ 'music.pause_label'|trans }}">
                    <span id="play" aria-hidden="true">
                        <svg class="bi bi-play-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 010 1.393z"/></svg>
                    </span>

                    <span id="pause" aria-hidden="true" style="display: none">
                        <svg class="bi bi-pause-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M5.5 3.5A1.5 1.5 0 017 5v6a1.5 1.5 0 01-3 0V5a1.5 1.5 0 011.5-1.5zm5 0A1.5 1.5 0 0112 5v6a1.5 1.5 0 01-3 0V5a1.5 1.5 0 011.5-1.5z"/></svg>
                    </span>

                </button>

                <button type="button" id="loopRegion" class="player-btn" aria-pressed="false">
                    <span id="loop" aria-hidden="true">
                        <svg class="bi bi-arrow-repeat" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M2.854 7.146a.5.5 0 00-.708 0l-2 2a.5.5 0 10.708.708L2.5 8.207l1.646 1.647a.5.5 0 00.708-.708l-2-2zm13-1a.5.5 0 00-.708 0L13.5 7.793l-1.646-1.647a.5.5 0 00-.708.708l2 2a.5.5 0 00.708 0l2-2a.5.5 0 000-.708z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M8 3a4.995 4.995 0 00-4.192 2.273.5.5 0 01-.837-.546A6 6 0 0114 8a.5.5 0 01-1.001 0 5 5 0 00-5-5zM2.5 7.5A.5.5 0 013 8a5 5 0 009.192 2.727.5.5 0 11.837.546A6 6 0 012 8a.5.5 0 01.501-.5z" clip-rule="evenodd"/></svg>
                    </span>{{ 'music.loop'|trans }}</button>
                <input id="slider" data-action="zoom" type="range" min="1" max="200" value="0" aria-label="{{ 'music.zoom_label'|trans }}"/>
            </div>
        </div>

        <div class="playlist-wrap">
            {# Avant : 2 accordéons Bootstrap "Disco"/"Rock" bidons, l'entité
               Track n'a aucun champ genre, les deux itéraient sur la même
               liste tracks en entier (doublons garantis, et le 2e avait même
               un href codé en dur vers un fichier de test). Une seule vraie
               liste plutôt que deux fausses catégories. #}
            <div class="playlist float-left" id="playlist">
                {% for track in tracks %}
                    <a href="{{ asset('uploads/music/' ~ track.trackFilename) }}" class="list-group-item">
                        <svg class="bi bi-play-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 010 1.393z"/></svg>
                        {{ track.title }}
                        {{ 'music.by'|trans }}
                        {{ track.artist.name }}
                        <span class="badge">{{ track.minutes }}:{{ track.seconds }}</span>
                    </a>
                {% else %}
                    <span class="empty-note">{{ 'music.no_records'|trans }}</span>
                {% endfor %}
            </div>

            <div class="members-only float-left">
                {% if app.user %}
                    {# Avant : d-none codé en dur ici, jamais retiré, donc
                       invisible même connecté·e. Le {% if app.user %}
                       ci-dessus gère déjà la visibilité, ce d-none était
                       redondant et faux. #}
                    <div class="loggedinContent">
                        {% for track in tracks %}
                            <span class="list-group-item">{{ 'music.voice_label'|trans }}
                                {{ track.artist.name }}
                                <a href="{{ path('track_show', {id: track.id}) }}">{{ 'music.download'|trans }}</a>
                            </span>
                        {% else %}
                            <span class="empty-note">{{ 'music.no_links'|trans }}</span>
                        {% endfor %}
                    </div>
                {% else %}
                    {# Pas de formulaire de connexion ad hoc ici : à terme, un
                       composant popup de connexion réutilisable (cf. ROADMAP.md),
                       en attendant on renvoie vers la vraie page /join. #}
                    <p class="members-prompt">
                        {{ 'music.members_prompt'|trans }}
                        <a href="{{ path('join') }}">{{ 'nav.join_or_login'|trans }}</a>
                    </p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="loading" id="js-loader" aria-hidden="true">
        <div class="loader"></div>
    </div>
    <div class="mascotte" aria-hidden="true">
        <canvas id="c"></canvas>
    </div>

{% endblock %}

{% block javascripts %}
    {# Épinglé à 6.6.4 (dernière version 6.x) : sans version, unpkg résout la
       dernière release (7.x), une réécriture complète en modules ES qui n'a
       plus l'API globale WaveSurfer.create()/.regions.create() qu'utilise
       Player.js. Même piège que bootstrap/three.js, déjà documenté dans
       CLAUDE.md, jamais appliqué ici avant le 2026-08-10. #}
    <script src="https://unpkg.com/wavesurfer.js@6.6.4"></script>
    <script src="https://unpkg.com/wavesurfer.js@6.6.4/dist/plugin/wavesurfer.regions.min.js"></script>
{% endblock %}
