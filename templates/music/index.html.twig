{% extends 'base.html.twig' %}

{% block importmap %}
    {# On small screens the 3D furniture/character become tiny and the scene eats all the useful space, so music.js reads this class and entirely skips the Three.js init; the player and playlist stay displayed in normal flow. Set before the first render to avoid a flash. #}
    <script>
        document.documentElement.classList.add(window.matchMedia('(max-width: 700px)').matches ? 'is-mobile' : 'is-desktop');
    </script>
    {{ importmap(['app', 'music']) }}
{% endblock %}

{% block fonts %}
    {# VT323 (title/ticker) + IBM Plex Mono (labels/counter): the same pair already used on /story for its own retro "screen", reused here rather than introducing a 3rd font. #}
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
{% endblock %}

{% block title %}{{ 'music.title'|trans }}
{% endblock %}

{% block body %}

    <h1 class="sr-only">{{ 'music.title'|trans }}</h1>

    <p class="mobile-note">{{ 'music.mobile_note'|trans }}</p>

    {# Small audio screen, glued to the 3D furniture via updateOverlayPosition() in music.js. The YouTube video overlay below (#videoOverlay) is a separate large screen that opens over the whole page on demand, independent of this one. #}
    <div class="overlay">
        {# This h2 is deliberately kept outside .player-wrap: music.js targets ".player-wrap .row:first-child" to reposition the waveform via 3D projection, and a child added before .row would break that selector. #}
        <h2 class="sr-only">{{ 'music.player_heading'|trans }}</h2>
        {# Announces the current track on every change (click or automatic next), for a screen reader user not looking at the playlist at that moment. #}
        <p id="now-playing" class="sr-only" aria-live="polite"></p>
        <div class="player-wrap">
            <div class="row">

                <div class="waveW">
                    <div id="waveform"></div>

                    {# "Screen" chrome overlaid absolutely on top of the waveform, never reserving its own space, so it doesn't affect the rectangle positioned in 3D by updateOverlayPosition(). Decorative, aria-hidden: the LED/counter add nothing beyond what #now-playing already announces to a screen reader. #}
                    <div class="screen-chrome" aria-hidden="true">
                        <span class="power-led" id="powerLed"></span>
                        <span class="track-counter" id="trackCounter"></span>
                    </div>
                    <p class="screen-ticker" id="screenTicker" aria-hidden="true"></p>
                </div>
            </div>
            <div
                class="row playerButtons" role="region" aria-label="{{ 'music.player_region'|trans }}">
                {% if is_granted('FOLDER_WRITE', 'music') %}
                    {# The yellow dot near the player controls is a 2nd trigger for the "Manage setlist" modal below, more visible/accessible here than the same-named button tucked away in "Members area". A real <button> since it only opens a JS modal now, see initDialog() in music.js, which accepts multiple triggers for the same modal. #}
                    <button type="button" id="uploadNew" class="player-btn">
                        <span id="upload">
                            <svg class="bi bi-circle-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
                            {{ 'music.manage_setlist'|trans }}</span>
                    </button>
                {% endif %}

                {# Real <button> elements rather than plain <div>s: a keyboard activation (Enter/Space) already fires the "click" event Player.js listens for, no JS handler change needed. aria-label set here as a baseline; Player.js updates it dynamically for Play/Pause based on real state. #}
                <button type="button" id="stopTrack" class="player-btn" aria-label="{{ 'music.stop_label'|trans }}">
                    <span id="stop" aria-hidden="true">
                        <svg class="bi bi-stop-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M5 3.5h6A1.5 1.5 0 0112.5 5v6a1.5 1.5 0 01-1.5 1.5H5A1.5 1.5 0 013.5 11V5A1.5 1.5 0 015 3.5z"/></svg>
                    </span>
                </button>

                {# data-play-label/data-pause-label: read by Player.js to keep aria-label in sync with real play/pause state, keeping translations in Twig rather than hardcoded in JS. #}
                <button type="button" id="playPause" class="player-btn" aria-label="{{ 'music.play_label'|trans }}" data-play-label="{{ 'music.play_label'|trans }}" data-pause-label="{{ 'music.pause_label'|trans }}">
                    <span id="play" aria-hidden="true">
                        <svg class="bi bi-play-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 010 1.393z"/></svg>
                    </span>

                    <span id="pause" aria-hidden="true" style="display: none">
                        <svg class="bi bi-pause-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M5.5 3.5A1.5 1.5 0 017 5v6a1.5 1.5 0 01-3 0V5a1.5 1.5 0 011.5-1.5zm5 0A1.5 1.5 0 0112 5v6a1.5 1.5 0 01-3 0V5a1.5 1.5 0 011.5-1.5z"/></svg>
                    </span>

                </button>

                <button type="button" id="loopRegion" class="player-btn" aria-pressed="false">
                    <span id="loop" aria-hidden="true">
                        <svg class="bi bi-arrow-repeat" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M2.854 7.146a.5.5 0 00-.708 0l-2 2a.5.5 0 10.708.708L2.5 8.207l1.646 1.647a.5.5 0 00.708-.708l-2-2zm13-1a.5.5 0 00-.708 0L13.5 7.793l-1.646-1.647a.5.5 0 00-.708.708l2 2a.5.5 0 00.708 0l2-2a.5.5 0 000-.708z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M8 3a4.995 4.995 0 00-4.192 2.273.5.5 0 01-.837-.546A6 6 0 0114 8a.5.5 0 01-1.001 0 5 5 0 00-5-5zM2.5 7.5A.5.5 0 013 8a5 5 0 009.192 2.727.5.5 0 11.837.546A6 6 0 012 8a.5.5 0 01.501-.5z" clip-rule="evenodd"/></svg>
                    </span>{{ 'music.loop'|trans }}</button>
                <input id="slider" data-action="zoom" type="range" min="1" max="200" value="0" aria-label="{{ 'music.zoom_label'|trans }}"/>
                </div>
            </div>
        </div>
    </div>

    {# Large video overlay over the whole page (3D scene included), opened on a YouTube badge click. Independent of the small audio screen above, they're never shown at once (see the music:show-video/music:audio-playing CustomEvents exchanged between Player.js and youtube-embed.js). #}
    <div id="videoOverlay" class="video-overlay d-none" role="dialog" aria-modal="true" aria-labelledby="video-overlay-title">
        <div class="video-overlay-backdrop" data-close></div>
        <div class="video-overlay-content">
            <h2 id="video-overlay-title" class="sr-only">{{ 'music.youtube_embed_title_prefix'|trans }}</h2>
            <button type="button" class="video-overlay-close" data-close aria-label="{{ 'music.now_playing_close'|trans }}">
                <span aria-hidden="true">&times;</span>
            </button>
            <div id="youtube-embed" data-embed-title-prefix="{{ 'music.youtube_embed_title_prefix'|trans }}"></div>
        </div>
    </div>

    <div class="playlist-wrap">
            {# A setlist item with no audio file has nothing to load in wavesurfer, so it's rendered as a <span> rather than a clickable link, leaving the YouTube link (if any) as the only way to hear it. <ul>/<li> rather than a flat <a>/<span> stream so a screen reader announces "list of N items". #}
            <h2 class="sr-only">{{ 'music.playlist_heading'|trans }}</h2>
            {# Decorative visual label: the sr-only h2 above already carries the region's accessible name, this duplicate is deliberately hidden from screen readers. #}
            <p class="console-label" aria-hidden="true">{{ 'music.playlist_heading'|trans }}</p>
            <ul class="playlist float-left" id="playlist">
                {% for item in items %}
                    {% set media = item.firstMediaDocument %}
                    {% set songLabel %}
                        <svg class="bi bi-play-fill" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 010 1.393z"/></svg>
                        {{ item.title }}
                        {% if item.artist %}
                            {{ 'music.by'|trans }}
                            {{ item.artist.name }}
                        {% endif %}
                        {% if item.youtubeUrl %}
                            {# data-youtube-id is intercepted by youtube-embed.js to open the video on-screen rather than navigating; href/target=_blank remain a fallback if JS failed to load. Open to everyone, unlike the audio link above reserved to binioufous/admins. #}
                            <a href="{{ item.youtubeUrl }}" class="badge" target="_blank" rel="noopener" data-youtube-id="{{ item.youtubeId }}" data-youtube-title="{{ item.artist ? (item.title ~ ' ' ~ 'music.by'|trans ~ ' ' ~ item.artist.name) : item.title }}">{{ 'music.youtube_link'|trans }}</a>
                        {% endif %}
                    {% endset %}
                    <li>
                        {# Listening to the real audio file is reserved to binioufous/admins, same read rule as the /desk/files/music space: the public only gets the title/artist/YouTube link above, never a direct mp3 link. #}
                        {% if media and (is_granted('ROLE_BINIOUFOUS') or is_granted('ROLE_ADMIN')) %}
                            {# data-track-title: Player.js announces it in the aria-live region on every track change, rather than reusing the link's rich HTML (icon + YouTube badge), unsuited to a voice announcement. #}
                            <a href="{{ asset('uploads/documents/' ~ media.filename) }}" class="list-group-item" data-track-title="{{ item.artist ? (item.title ~ ' ' ~ 'music.by'|trans ~ ' ' ~ item.artist.name) : item.title }}">{{ songLabel|raw }}</a>
                        {% else %}
                            <span class="list-group-item">{{ songLabel|raw }}</span>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="empty-note">{{ 'music.no_records'|trans }}</li>
                {% endfor %}
            </ul>

            <div class="members-only float-left">
                <h2 class="sr-only">{{ 'music.members_heading'|trans }}</h2>
                {% if is_granted('ROLE_BINIOUFOUS') or is_granted('ROLE_ADMIN') %}
                    {# "Raw files" view reserved to binioufous: each song's voices/parts, plus a link to the full file manager rather than a second render of the tree here. #}
                    <ul class="loggedinContent">
                        {% for item in items %}
                            <li class="list-group-item">
                                <strong>{{ item.title }}</strong>
                                {% if item.artist %}{{ 'music.by'|trans }} {{ item.artist.name }}{% endif %}
                                <ul class="music-voices">
                                    {% for document in item.mediaDocuments %}
                                        {% set playing = document.playedBy.contains(app.user) %}
                                        <li>
                                            <form method="post" action="{{ path('document_played_toggle', {space: 'music', id: document.id}) }}" class="btn-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_played' ~ document.id) }}">
                                                <button type="submit" class="desk-voice-toggle{{ playing ? ' active' : '' }}" aria-pressed="{{ playing ? 'true' : 'false' }}">
                                                    {{ document.name }}
                                                    {% if playing %}
                                                        <span class="sr-only">{{ 'desk.voice_playing'|trans }}</span>
                                                    {% endif %}
                                                </button>
                                            </form>
                                            <a href="{{ asset('uploads/documents/' ~ document.filename) }}">{{ 'music.voice_listen'|trans }}</a>
                                            <span class="desk-voice-players">
                                                {% if document.playedBy|length > 0 %}
                                                    {{ 'desk.voice_played_by'|trans }}
                                                    {% for user in document.playedBy %}{{ user.nickname }}{% if not loop.last %}, {% endif %}{% endfor %}
                                                {% else %}
                                                    {{ 'desk.voice_no_players'|trans }}
                                                {% endif %}
                                            </span>
                                        </li>
                                    {% else %}
                                        <li>{{ 'music.no_voices'|trans }}</li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% else %}
                            <li class="empty-note">{{ 'music.no_links'|trans }}</li>
                        {% endfor %}
                    </ul>
                    {% if is_granted('FOLDER_WRITE', 'music') %}
                        {# Opens the modal below via JS. Placed here, inside .members-only which is already repositioned fixed by updateOverlayPosition() via its parent, rather than as a separate fixed button, so it stays in the same block as "View all files" and inherits the same working positioning. #}
                        <button type="button" id="setlistManageTrigger" class="btn btn-green setlist-manage-trigger">
                            <i class="ri-music-2-line" aria-hidden="true"></i> {{ 'music.manage_setlist'|trans }}
                        </button>
                    {% endif %}
                    <a href="{{ path('desk_files', {space: 'music'}) }}" class="btn btn-green">{{ 'music.files_link'|trans }}</a>
                {% elseif app.user %}
                    <div class="members-prompt">
                        <p>{{ 'music.members_prompt'|trans }}</p>
                    </div>
                {% else %}
                    <div class="members-prompt">
                        <p>{{ 'music.members_prompt'|trans }}</p>
                        <button type="button" id="musicLoginTrigger" class="btn btn-primary">
                            {{ 'nav.join_or_login'|trans }}
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>

    </div>

    {% if is_granted('FOLDER_WRITE', 'music') %}
        {# Deliberately outside the 3D projection system: this modal stays in normal flow/position, so its z-index and visibility never depend on the 3D canvas. Same accessibility skeleton as components/form-dialog.html.twig, without reusing that component: form-dialog.html.twig IS itself a <form>, but this needs several distinct <form> elements (add + one per song) that can't nest in HTML. #}
        <div id="setlistManageDialog" class="setlist-dialog d-none" role="dialog" aria-modal="true" aria-labelledby="setlist-dialog-title">
            <div class="setlist-dialog-backdrop" data-close></div>
            <div class="setlist-dialog-content">
                <div class="dialog-header">
                    <h2 id="setlist-dialog-title">{{ 'music.manage_setlist'|trans }}</h2>
                    <button type="button" class="close" data-close aria-label="{{ 'common.close'|trans }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="dialog-body">
                    {# "folder" links directly to an existing Folder (select filled from FolderRepository::findTopLevel()) rather than creating one on the fly from free text, which was prone to typo duplicates: the folder and its audio files must already exist before being linked here. #}
                    <h3>{{ 'music.add_song'|trans }}</h3>
                    <form method="post" action="{{ path('setlist_new') }}">
                        <label for="setlist-title">{{ 'music.track_title'|trans }}</label>
                        <input type="text" id="setlist-title" name="title" required maxlength="255">

                        <label for="setlist-artist">{{ 'music.artist'|trans }}</label>
                        <select id="setlist-artist" name="artist">
                            <option value="">{{ 'music.no_artist'|trans }}</option>
                            {% for artist in artists %}
                                <option value="{{ artist.id }}">{{ artist.name }}</option>
                            {% endfor %}
                        </select>

                        {# When filled, takes priority over the select above: creates the artist on the fly (or reuses an existing one with the same name) instead of depending only on fixtures to populate the list. #}
                        <label for="setlist-new-artist">{{ 'music.new_artist_label'|trans }}</label>
                        <input type="text" id="setlist-new-artist" name="new_artist" placeholder="{{ 'music.new_artist_placeholder'|trans }}" maxlength="255">

                        <label for="setlist-youtube">{{ 'music.youtube_url_label'|trans }}</label>
                        <input type="url" id="setlist-youtube" name="youtubeUrl">

                        <label for="setlist-folder">{{ 'music.folder_label'|trans }}</label>
                        <select id="setlist-folder" name="folder" aria-describedby="setlist-folder-hint">
                            <option value="">{{ 'music.folder_empty_option'|trans }}</option>
                            {% for folder in musicFolders %}
                                <option value="{{ folder.id }}">{{ folder.name }}</option>
                            {% endfor %}
                        </select>
                        <p id="setlist-folder-hint" class="field-hint">
                            {% if musicFolders|length > 0 %}
                                {{ 'music.folder_hint'|trans }}
                            {% else %}
                                {{ 'music.folder_hint_empty'|trans }}
                            {% endif %}
                            <a href="{{ path('desk_files', {space: 'music'}) }}">{{ 'music.files_link'|trans }}</a>
                        </p>

                        <input type="hidden" name="_token" value="{{ csrf_token('create_setlist_item') }}">
                        <button type="submit" class="btn btn-green">{{ 'music.add_song'|trans }}</button>
                    </form>

                    <h3>{{ 'music.setlist_list_heading'|trans }}</h3>
                    <ol class="setlist-admin-list">
                        {% for item in items %}
                            <li>
                                <details class="setlist-edit">
                                    <summary>{{ item.title }}</summary>
                                    <form method="post" action="{{ path('setlist_edit', {id: item.id}) }}">
                                        <label for="edit-title-{{ item.id }}">{{ 'music.track_title'|trans }}</label>
                                        <input type="text" id="edit-title-{{ item.id }}" name="title" value="{{ item.title }}" required maxlength="255">

                                        <label for="edit-artist-{{ item.id }}">{{ 'music.artist'|trans }}</label>
                                        <select id="edit-artist-{{ item.id }}" name="artist">
                                            <option value="">{{ 'music.no_artist'|trans }}</option>
                                            {% for artist in artists %}
                                                <option value="{{ artist.id }}"{{ item.artist and item.artist.id == artist.id ? ' selected' : '' }}>{{ artist.name }}</option>
                                            {% endfor %}
                                        </select>

                                        <label for="edit-new-artist-{{ item.id }}">{{ 'music.new_artist_label'|trans }}</label>
                                        <input type="text" id="edit-new-artist-{{ item.id }}" name="new_artist" placeholder="{{ 'music.new_artist_placeholder'|trans }}" maxlength="255">

                                        <label for="edit-youtube-{{ item.id }}">{{ 'music.youtube_url_label'|trans }}</label>
                                        <input type="url" id="edit-youtube-{{ item.id }}" name="youtubeUrl" value="{{ item.youtubeUrl }}">

                                        <label for="edit-folder-{{ item.id }}">{{ 'music.folder_label'|trans }}</label>
                                        <select id="edit-folder-{{ item.id }}" name="folder">
                                            <option value="">{{ 'music.folder_empty_option'|trans }}</option>
                                            {% set folderStillListed = false %}
                                            {% for folder in musicFolders %}
                                                {% if item.folder and item.folder.id == folder.id %}{% set folderStillListed = true %}{% endif %}
                                                <option value="{{ folder.id }}"{{ item.folder and item.folder.id == folder.id ? ' selected' : '' }}>{{ folder.name }}</option>
                                            {% endfor %}
                                            {% if item.folder and not folderStillListed %}
                                                {# Linked folder isn't a top-level one (a subfolder, or created before top-level-only linking existed): kept as the default selected option so saving without touching this field doesn't silently unlink it. #}
                                                <option value="{{ item.folder.id }}" selected>
                                                    {%- for ancestor in item.folder.ancestors[1:] -%}{{ ancestor.name }} / {%- endfor -%}{{ item.folder.name }}
                                                </option>
                                            {% endif %}
                                        </select>

                                        <input type="hidden" name="_token" value="{{ csrf_token('edit_setlist_item' ~ item.id) }}">
                                        <button type="submit" class="btn btn-green">{{ 'music.edit_submit'|trans }}</button>
                                    </form>
                                </details>
                                {% if item.folder %}
                                    <a href="{{ path('desk_files', {space: 'music', folder: item.folder.id}) }}" class="setlist-files-link">
                                        <i class="ri-folder-music-line" aria-hidden="true"></i> {{ 'music.view_files'|trans }}
                                    </a>
                                {% endif %}
                                <form method="post" action="{{ path('setlist_move_up', {id: item.id}) }}" class="btn-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('move_setlist_item' ~ item.id) }}">
                                    <button type="submit" class="setlist-order-btn" aria-label="{{ 'music.move_up'|trans }}">↑</button>
                                </form>
                                <form method="post" action="{{ path('setlist_move_down', {id: item.id}) }}" class="btn-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('move_setlist_item' ~ item.id) }}">
                                    <button type="submit" class="setlist-order-btn" aria-label="{{ 'music.move_down'|trans }}">↓</button>
                                </form>
                                <form method="post" action="{{ path('setlist_delete', {id: item.id}) }}" class="btn-form" onsubmit="return confirm('{{ 'music.confirm_delete'|trans|e('js') }}');">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_setlist_item' ~ item.id) }}">
                                    <button type="submit" class="btn btn-red">{{ 'music.delete'|trans }}</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        </div>
    {% endif %}

    {{ include('components/form-dialog.html.twig', {
        id: 'musicLoginForm',
        action: path('join'),
        title: 'join.login_title',
        content: include('join/_login-generic.html.twig'),
    }) }}

    <div class="loading" id="js-loader" aria-hidden="true">
        <div class="loader"></div>
    </div>
    <div class="mascotte" aria-hidden="true">
        <canvas id="c"></canvas>
    </div>

{% endblock %}

{% block javascripts %}
    {# Pinned to 6.6.4: without a version, unpkg resolves the latest 7.x release, a full ES modules rewrite that drops the global WaveSurfer.create()/.regions.create() API Player.js relies on. #}
    <script src="https://unpkg.com/wavesurfer.js@6.6.4"></script>
    <script src="https://unpkg.com/wavesurfer.js@6.6.4/dist/plugin/wavesurfer.regions.min.js"></script>
{% endblock %}
