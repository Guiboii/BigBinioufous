{{ form_start(form) }}
<div class="form-group">
    {{ form_row(form.title) }}

    {# Aide-mémoire toujours visible, même contenu que templates/story_section/_form.html.twig #}
    <div class="markdown-help">
        <p class="markdown-help-title">{{ 'note.markdown_help_title'|trans }}</p>
        <ul>
            <li><code># Titre</code> {{ 'note.markdown_help_h1'|trans }}</li>
            <li><code>## Sous-titre</code> {{ 'note.markdown_help_h2'|trans }}</li>
            <li><code>**gras**</code> {{ 'note.markdown_help_bold'|trans }} <strong>{{ 'note.markdown_help_bold_example'|trans }}</strong></li>
            <li><code>*italique*</code> {{ 'note.markdown_help_italic'|trans }} <em>{{ 'note.markdown_help_italic_example'|trans }}</em></li>
            <li><code>~~barré~~</code> {{ 'note.markdown_help_strike'|trans }} <del>{{ 'note.markdown_help_strike_example'|trans }}</del></li>
            <li><code>- élément</code> {{ 'note.markdown_help_list'|trans }}</li>
            <li><code>[texte](https://exemple.fr)</code> {{ 'note.markdown_help_link'|trans }}</li>
        </ul>
    </div>

    {{ form_row(form.content) }}
    {{ form_row(form.shared) }}
    <button type="submit" class="btn btn-green">{{ (button_label|default('note.save_submit'))|trans }}</button>
</div>
{{ form_end(form) }}
