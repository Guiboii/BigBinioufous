<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}Binioufous!
            {% endblock %}
        </title>
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
{# The icon font is pulled in through a CSS import buried in app.js's module graph, so the browser discovers it late and the navbar icons pop in well after the rest of the page. Preloading it here starts that download immediately. #}
        <link rel="preload" as="font" type="font/woff2" href="{{ asset('vendor/remixicon/fonts/remixicon.woff2') }}" crossorigin>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet">
{# Empty by default: lets a page load an extra font without duplicating the preconnect links above. #}
        {% block fonts %}{% endblock %}
        <script>
            window.BB_ASSETS = {
'mascotte/Binioufou_Final4.gltf': '{{ asset('mascotte/Binioufou_Final4.gltf') }}',
'mascotte/moveB.gltf': '{{ asset('mascotte/moveB.gltf') }}',
'story/Soucoupe.gltf': '{{ asset('story/Soucoupe.gltf') }}',
'story/Desk.gltf': '{{ asset('story/Desk.gltf') }}',
'story/Desk1.gltf': '{{ asset('story/Desk1.gltf') }}',
'music/SoundSystem.gltf': '{{ asset('music/SoundSystem.gltf') }}',
'schedule/flyer002.png': '{{ asset('schedule/flyer002.png') }}'
};
        </script>
    </head>
    <body>
        {# First keyboard-reachable element: stays invisible until it receives Tab focus, letting a keyboard user skip the navbar/3D scene straight to the main content. #}
        <a class="skip-link" href="#main-content">{{ 'a11y.skip_to_content'|trans }}</a>
        {{ include('/partials/header.html.twig') }}
        {% for label, messages in app.flashes %}
            <div class="container">
                <div class="alert alert-{{ label }} mt-4">
                    {% for message in messages %}
                        <p>{{ message }}</p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
        <main id="main-content" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
        {% block javascripts %}{% endblock %}
    </body>

</html>
