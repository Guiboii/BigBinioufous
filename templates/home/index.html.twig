{% extends 'base.html.twig' %}

{% block title %}Binioufous!
{% endblock %}

{% block body %}
    {# The real content (home, navigation) already lives in base.html.twig's navbar: this h1 gives the page a valid single-h1 structure without visually duplicating a title. The 3D scene is a "bonus" way to navigate (clicking furniture...) on top of the navbar's real links, not the only one, so the canvas and loading overlay are aria-hidden and keyboard/screen reader navigation stays possible via the navbar. #}
    <h1 class="sr-only">{{ 'home.heading'|trans }}</h1>
    <div class="loading" id="js-loader" aria-hidden="true">
        <div class="loader"></div>
    </div>
    <div class="mascotte" aria-hidden="true">
        <canvas id="c"></canvas>
    </div>
    <video id="video1" loop="" crossorigin="anonymous" playsinline="" style="display:none" autoplay="true" muted="muted"><source src="{{ asset('story/Foryou3.mp4') }}" type="video/mp4"></video>
    <video id="video2" loop="" crossorigin="anonymous" playsinline="" style="display:none" autoplay="true" muted="muted"><source src="{{ asset('schedule/soucoupe.mp4') }}" type="video/mp4"></video>
{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'index']) }}
{% endblock %}
