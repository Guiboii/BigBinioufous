{% extends 'base.html.twig' %}
{% block importmap %}
    {{ importmap('app') }}
    <link rel="stylesheet" href="{{ asset('story/story.css') }}">
{% endblock %}

{% block title %}
    {{ 'story.title'|trans }}
{% endblock %}

{% block header %}
    <nav class="mini navbar navbar-dark">

        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link" href="#intro">{{ 'story.nav_intro'|trans }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#cki">{{ 'story.nav_who'|trans }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#ckoi">{{ 'story.nav_what'|trans }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#prq">{{ 'story.nav_why'|trans }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#contact">{{ 'story.nav_contact'|trans }}</a>
            </li>
        </ul>

    </nav>

{% endblock %}

{% block body %}

    <div data-spy="scroll" data-target="#navbar-example2" data-offset="0">
        <div>
            <h4 id="intro">{{ 'story.nav_intro'|trans }}</h4>
            <br>
            <p>{{ 'story.intro'|trans }}</p>
            <h3 id="cki">
                <br>
                <br>
                {{ 'story.who_title'|trans }}</h3>
            <h4>{{ 'story.who_ages_title'|trans }}</h4>
            <p>{{ 'story.who_ages_text'|trans }}</p>
            <h4>{{ 'story.who_instruments_title'|trans }}</h4>
            <p>{{ 'story.who_instruments_text'|trans }}</p>
            <h4>{{ 'story.who_level_title'|trans }}</h4>
            <p>{{ 'story.who_level_text'|trans|raw }}</p>
            <h4>{{ 'story.who_no_sheet_title'|trans }}</h4>
            <p>{{ 'story.who_no_sheet_text'|trans }}</p>
            <h3 id="ckoi">
                <br>
                <br>
                {{ 'story.what_title'|trans }}</h3>
            <p>{{ 'story.what_intro_text'|trans }}</p>
            <p>{{ 'story.what_oboe_text'|trans }}</p>
            <p>{{ 'story.what_instrument_text'|trans }}</p>
            <h4>{{ 'story.history_title'|trans|raw }}</h4>
            <p>{{ 'story.history_ok'|trans }}</p>
            <p>{{ 'story.history_text'|trans }}</p>
            <h3 id="prq">
                <br>
                <br>
                {{ 'story.why_title'|trans }}</h3>
            <h4>{{ 'story.why_party_title'|trans }}</h4>
            <p>{{ 'story.why_party_text'|trans }}</p>
            <li>{{ 'story.why_li_concert'|trans }}</li>
            <li>{{ 'story.why_li_teacher'|trans }}</li>
            <li>{{ 'story.why_li_school'|trans }}</li>
            <li>{{ 'story.why_li_clarinet'|trans }}</li>
            <br>
            <p>{{ 'story.why_outro'|trans }}</p>
        </div>
        <form id="contact">

            <h4>{{ 'contact.title'|trans }}</h4>
            <div class="form-group">
                <label for="exampleFormControlInput1">{{ 'contact.name_label'|trans }}</label>
                <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="John Doe">
            </div>
            <div class="form-group">
                <label for="exampleFormControlSelect1">{{ 'contact.email_label'|trans }}</label>
                <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="name@example.com">
            </div>

            <div class="form-group">
                <label for="exampleFormControlTextarea1">{{ 'contact.message_label'|trans }}</label>
                <textarea class="form-control" id="exampleFormControlTextarea1" rows="2"></textarea>
            </div>
            <button type="button" class="btn btn-dark">{{ 'contact.submit'|trans }}</button>
        </form>
    </div>

{% endblock %}
