<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ 'story.title'|trans }}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=VT323&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('story/minisite.css') }}">
        {# This page serves 2 roles: content shown in the #miniSite iframe on /story's 3D screen (desktop), and a standalone page when /story redirects here on mobile. Only the 2nd case needs a navbar, detected before the first render to avoid a flash. #}
        <script>
            document.documentElement.classList.add(window.self !== window.top ? 'is-embedded' : 'is-standalone');
        </script>
    </head>
    <body>
        <nav class="site-nav" aria-label="{{ 'nav.tagline'|trans }}">
            <p class="site-nav-note">{{ 'story.mobile_note'|trans }}</p>
            <div class="site-nav-links">
                <a href="{{ path('home') }}">{{ 'nav.home'|trans }}</a>
                <a href="{{ path('music') }}">{{ 'nav.music'|trans }}</a>
                <a href="{{ path('schedule') }}">{{ 'nav.schedule'|trans }}</a>
                {% if app.user %}
                    <a href="{{ path('desk') }}">{{ 'nav.desk'|trans }}</a>
                {% else %}
                    <a href="{{ path('join') }}">{{ 'nav.join_or_login'|trans }}</a>
                {% endif %}
            </div>
        </nav>

        <div class="desktop">
            <div class="desktop-icons" aria-hidden="true">
                <span class="desktop-icon desktop-icon--folder"></span>
                <span class="desktop-icon desktop-icon--trash"></span>
            </div>

            <div class="term-window">
                <div class="term-titlebar">
                    <span class="term-dots" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </span>
                    BINIOUFOUS.SYS<span class="term-cursor">_</span>
                </div>
                <nav class="term-nav" aria-label="{{ 'story.title'|trans }}">
                    {% for section in sections %}
                        <a href="#{{ section.slug }}">{{ section.title }}</a>
                    {% endfor %}
                    <a href="#contact">{{ 'story.nav_contact'|trans }}</a>
                </nav>

                <main>
                    {# Sections editable by ROLE_ADMIN, Markdown content rendered to HTML. A single h1 per page: the first section carries it, the rest use h2. #}
                    {% for section in sections %}
                        <section id="{{ section.slug }}">
                            {% if loop.first %}
                                <h1>{{ section.title }}</h1>
                            {% else %}
                                <h2>{{ section.title }}</h2>
                            {% endif %}
                            {{ section.content|markdown_to_html }}
                        </section>
                    {% endfor %}

                    <section id="contact">
                        <h2>{{ 'contact.title'|trans }}</h2>
                        <form class="term-form" id="minisite-contact-form" action="{{ path('contact_submit') }}" method="post" data-messages="{{ {
                            sending: 'contact.sending'|trans,
                            success: 'contact.success'|trans,
                            invalid_email: 'contact.error_invalid_email'|trans,
                            empty_message: 'contact.error_empty_message'|trans,
                            generic: 'contact.error_generic'|trans,
                        }|json_encode }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                            <input type="hidden" name="contact_ts" value="{{ 'now'|date('U') }}">
                            {# Honeypot, same trap and reason as story/index.html.twig. #}
                            <input type="text" class="hp-field" id="minisite-contact-hp" name="contact_hp" tabindex="-1" autocomplete="off" aria-hidden="true">
                            <div class="term-field">
                                <label for="minisite-contact-name">{{ 'contact.name_label'|trans }}</label>
                                <input type="text" id="minisite-contact-name" name="name" placeholder="John Doe">
                            </div>
                            <div class="term-field">
                                <label for="minisite-contact-email">{{ 'contact.email_label'|trans }}</label>
                                <input type="email" id="minisite-contact-email" name="email" placeholder="name@example.com">
                            </div>
                            <div class="term-field">
                                <label for="minisite-contact-message">{{ 'contact.message_label'|trans }}</label>
                                <textarea id="minisite-contact-message" name="message" rows="3"></textarea>
                            </div>
                            <p class="contact-status" id="minisite-contact-status" aria-live="polite"></p>
                            <button type="submit" class="term-submit">{{ 'contact.submit'|trans }}</button>
                        </form>
                    </section>
                </main>
            </div>

            <div class="taskbar">
                <span class="taskbar-start" aria-hidden="true"></span>
                <span class="taskbar-status" aria-hidden="true">
                    <span class="taskbar-battery"><span class="taskbar-battery-fill"></span></span>
                    <span class="taskbar-clock" id="taskbar-clock"></span>
                </span>
            </div>
        </div>

        <script>
            var clockEl = document.getElementById('taskbar-clock');
            function updateClock() {
                var now = new Date();
                var hh = String(now.getHours()).padStart(2, '0');
                var mm = String(now.getMinutes()).padStart(2, '0');
                clockEl.textContent = hh + ':' + mm;
            }
            updateClock();
            setInterval(updateClock, 1000 * 15);
        </script>
        {# Standalone page with no importmap, so this small script is served as-is via asset() instead, same as minisite.css above. #}
        <script src="{{ asset('story/minisite.js') }}" defer></script>
    </body>
</html>
