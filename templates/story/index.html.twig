{% extends 'base.html.twig' %}

{% block importmap %}
    {# Sur petit écran, la scène 3D écrase tout et le "moniteur" avec le
       terminal dedans devient minuscule/illisible : on redirige direct
       vers le contenu de la minisite (déjà responsive en autonome) avant
       de charger les assets 3D, plutôt que de les charger pour rien. #}
    <script>
        if (window.matchMedia('(max-width: 700px)').matches) {
            window.location.replace('{{ path('minisite') }}');
        }
    </script>
    {{ importmap(['app', 'story']) }}
{% endblock %}

{% block title %}
    {{ 'story.title'|trans }}
{% endblock %}

{% block body %}

    {# title obligatoire sur une iframe : sans nom accessible, un lecteur
       d'écran l'annonce juste "iframe" sans indiquer ce qu'elle contient. #}
    <iframe id="miniSite" src="{{ path('minisite') }}" title="{{ 'story.title'|trans }}"></iframe>
    {# Cette popup n'est atteignable qu'en cliquant un objet 3D précis (raycast,
       cf. story.js) : pas de déclencheur clavier direct. Le vrai formulaire de
       contact accessible au clavier/lecteur d'écran est celui de la minisite
       (#contact dans story/minisite.html.twig, atteignable via la navbar de
       l'iframe). Celle-ci reste quand même gérée proprement une fois ouverte
       (role dialog, Echap, focus) pour les personnes qui l'ouvrent à la souris
       puis continuent au clavier. #}
    <form id="contactForm" class="d-none" role="dialog" aria-modal="true" aria-labelledby="contactFormTitle" method="post" action="{{ path('contact_submit') }}">
        <button type="button" class="close" aria-label="{{ 'common.close'|trans }}">
            <span aria-hidden="true">&times;</span>
        </button>
        <h4 id="contactFormTitle">{{ 'contact.title'|trans }}</h4>
        <div class="form-group">
            {# Avant : id="exampleFormControlInput1" dupliqué sur les 2 champs
               (nom ET email), donc le label "nom" pointait aussi vers le champ
               email (2e id gagne, 1er jamais atteint par un clic sur son label
               ni par un lecteur d'écran). Avant aussi : type="email" sur le
               champ nom (validation navigateur au mauvais endroit). #}
            <label for="contactName">{{ 'contact.name_label'|trans }}</label>
            <input type="text" class="form-control" id="contactName" name="name" autocomplete="name" placeholder="John Doe">
        </div>
        <div class="form-group">
            <label for="contactEmail">{{ 'contact.email_label'|trans }}</label>
            <input type="email" class="form-control" id="contactEmail" name="email" autocomplete="email" placeholder="name@example.com">
        </div>

        <div class="form-group">
            <label for="exampleFormControlTextarea1">{{ 'contact.message_label'|trans }}</label>
            <textarea class="form-control" id="exampleFormControlTextarea1" name="message" rows="2"></textarea>
        </div>
        {# Honeypot anti-bot : champ invisible pour une personne (CSS + hors tabulation),
           un bot qui remplit tout le formulaire à l'aveugle le remplit aussi. #}
        <div class="honeypot-field" aria-hidden="true">
            <label for="contactWebsite">Site web</label>
            <input type="text" id="contactWebsite" name="website" tabindex="-1" autocomplete="off">
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
        <p class="contact-feedback" role="status" aria-live="polite"
           data-sending="{{ 'contact.sending'|trans }}"
           data-success="{{ 'contact.success'|trans }}"
           data-error="{{ 'contact.error'|trans }}"></p>
        <button type="submit" class="btn btn-dark">{{ 'contact.submit'|trans }}</button>
    </form>
    <div class="loading" id="js-loader" aria-hidden="true">
        <div class="loader"></div>
    </div>
    <div class="mascotte" aria-hidden="true">
        {# tabindex="-1" : cible de script uniquement (story.js y renvoie le
           focus à la fermeture de #contactForm), jamais atteint par Tab
           (cohérent avec aria-hidden sur le parent). #}
        <canvas id="c" tabindex="-1"></canvas>
    </div>

{% endblock %}
