{% extends 'base.html.twig' %}

{% block importmap %}
    {# Sur petit écran, la scène 3D écrase tout et le "moniteur" avec le
       terminal dedans devient minuscule/illisible : on redirige direct
       vers le contenu de la minisite (déjà responsive en autonome) avant
       de charger les assets 3D, plutôt que de les charger pour rien. #}
    <script>
        if (window.matchMedia('(max-width: 700px)').matches) {
            window.location.replace('{{ path('minisite') }}');
        }
    </script>
    {{ importmap(['app', 'story']) }}
{% endblock %}

{% block title %}
    {{ 'story.title'|trans }}
{% endblock %}

{% block body %}

    <iframe id="miniSite" src="{{ path('minisite') }}"></iframe>
    <form id="contactForm" class="d-none">
        <button type="button" class="close" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <h4>{{ 'contact.title'|trans }}</h4>
        <div class="form-group">
            <label for="exampleFormControlInput1">{{ 'contact.name_label'|trans }}</label>
            <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="John Doe">
        </div>
        <div class="form-group">
            <label for="exampleFormControlSelect1">{{ 'contact.email_label'|trans }}</label>
            <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="name@example.com">
        </div>

        <div class="form-group">
            <label for="exampleFormControlTextarea1">{{ 'contact.message_label'|trans }}</label>
            <textarea class="form-control" id="exampleFormControlTextarea1" rows="2"></textarea>
        </div>
        <button type="button" class="btn btn-dark">{{ 'contact.submit'|trans }}</button>
    </form>
    <div class="loading" id="js-loader">
        <div class="loader"></div>
    </div>
    <div class="mascotte">
        <canvas id="c"></canvas>
    </div>

{% endblock %}
