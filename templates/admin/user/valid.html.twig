{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="profile-header">
            <a class="btn btn-red" href="{{ path ('valid') }}" aria-label="{{ 'admin.back_to_lists'|trans }}"><i class="ri-arrow-left-line" aria-hidden="true"></i></a>
            <div class="profile-identity">
                <div class="profile-avatar-frame">
                    {% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}
                </div>
                <div>
                    <h1 class="profile-name">{{ user.fullName }} {% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% elseif user.gender == 'female' %}<i class="ri-women-fill" aria-hidden="true"></i>{% else %}<i class="ri-genderless-fill" aria-hidden="true"></i>{% endif %}</h1>
                    <p class="profile-subtitle">{{ user.instrument ? user.instrument.title : '-' }} · {{ user.city|default('-') }}</p>
                </div>
            </div>
        </div>
        {# wish/numéro de carte retirés (inscription simplifiée, plus rien à
           vérifier ici à ce stade : cf. AdminController::validUser(), le
           rôle Membre/Pas membre se décide après coup via le toggle sur les
           listes desk). Prénom/nom/instrument/pays/ville/naissance
           facultatifs depuis la même simplification, tous affichés avec un
           repli "-" plutôt que de planter sur une valeur absente. #}
        <div class="row mt-4">
            <div class="col text-center">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'Instrument'|trans }}</th>
                            <th>{{ 'Country'|trans }}</th>
                            <th>{{ 'City'|trans }}</th>
                            <th>{{ 'admin.date_of_birth'|trans }}</th>
                            <th>{{ 'admin.created_at'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{{ user.instrument ? user.instrument.title : '-' }}</td>
                            <td>{{ user.country|default('-') }}</td>
                            <td>{{ user.city|default('-') }}</td>
                            <td>{{ user.birth ? user.birth|date('d/m/Y') : '-' }}</td>
                            <td>{{ user.createdAt|date('d/m/Y') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row centered mt-4">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="centered">
                <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
