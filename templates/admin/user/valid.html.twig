{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="profile-header">
            <a class="btn btn-red" href="{{ path ('valid') }}" aria-label="{{ 'admin.back_to_lists'|trans }}"><i class="ri-arrow-left-line" aria-hidden="true"></i></a>
            <div class="profile-identity">
                <div class="profile-avatar-frame">
                    {% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}
                </div>
                <div>
                    <h1 class="profile-name">{{ user.fullName }} {% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% elseif user.gender == 'female' %}<i class="ri-women-fill" aria-hidden="true"></i>{% else %}<i class="ri-genderless-fill" aria-hidden="true"></i>{% endif %}</h1>
                    <p class="profile-subtitle">{{ user.instrument.title }} · {{ user.city }}</p>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col text-center">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'admin.wish'|trans }}</th>
                            <th>{{ 'Instrument'|trans }}</th>
                            <th>{{ 'Country'|trans }}</th>
                            <th>{{ 'City'|trans }}</th>
                            <th>{{ 'admin.date_of_birth'|trans }}</th>
                            <th>{{ 'admin.created_at'|trans }}</th>
                            <th>{{ 'register.member_card_number'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{{ user.wish }}</td>
                            <td>{{ user.instrument.title }}</td>
                            <td>{{ user.country }}</td>
                            <td>{{ user.city }}</td>
                            <td>{{ user.birth|date('d/m/Y') }}</td>
                            <td>{{ user.createdAt|date('d/m/Y') }}</td>
                            {# Numéro à vérifier manuellement (pas d'API HelloAsso
                               disponible pour valider en direct, cf. RegistrationType).
                               Vide = la personne s'est déclarée non-adhérente à
                               l'inscription (wish Simple probable, ou une inscription
                               antérieure à cette fonctionnalité). #}
                            <td>{{ user.memberCardNumber ?: '-' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row centered mt-4">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="centered">
                <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
