{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullname }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="profile-header">
            <a class="btn btn-red" href="{{ path ('desk') }}" aria-label="{{ 'admin.back_to_lists'|trans }}"><i class="ri-arrow-left-line" aria-hidden="true"></i></a>
            <div class="profile-identity">
                <div class="profile-avatar-frame">
                    {% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}
                </div>
                <div>
                    <h1 class="profile-name">{{ user.fullName }} {% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% else %}<i class="ri-women-fill" aria-hidden="true"></i>{% endif %}</h1>
                    <p class="profile-subtitle">{{ user.instrument.title }} · {{ user.city }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-green" aria-label="{{ 'admin.contact'|trans }}"><i class="ri-mail-fill" aria-hidden="true"></i></button>
        </div>

        <div class="role-pills">
            {% for role in roles %}
                <span class="role-badge">
                    {{ role.description }}
                    <button type="button" class="btn btn-red" aria-label="{{ 'admin.remove_role_aria'|trans({'%role%': role.description}) }}"><i class="ri-forbid-line" aria-hidden="true"></i></button>
                </span>
            {% endfor %}
        </div>

        <div class="container text-center">
            <div class="card">
                <div class="card-label"><i class="ri-user-star-fill" aria-hidden="true"></i> {{ 'admin.promote_section'|trans }}</div>
                <div class="card-body row centered">
                    <a href="{{ path('create_admin', {slug: user.slug}) }}" class="btn btn-green mr-2">{{ 'admin.make_admin'|trans }}</a>
                    <a href="{{ path('create_accountant', {slug: user.slug}) }}" class="btn btn-green ml-2">{{ 'admin.make_accountant'|trans }}</a>
                </div>
            </div>
            <div class="card">
                <div class="card-label"><i class="ri-edit-line" aria-hidden="true"></i> {{ 'admin.edit_profile_section'|trans }}</div>
                <div class="card-body centered">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="centered">
                        <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
