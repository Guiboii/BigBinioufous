{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullname }}{% endblock %}

{% block importmap %}{{ importmap(['app', 'avatar-preview', 'instrument-other-toggle']) }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="profile-header">
            <a class="btn btn-red" href="{{ path ('desk') }}" aria-label="{{ 'admin.back_to_lists'|trans }}"><i class="ri-arrow-left-line" aria-hidden="true"></i></a>
            <div class="profile-identity">
                <div class="profile-avatar-frame">
                    {% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}
                </div>
                <div>
                    <h1 class="profile-name">{{ user.fullName }} {% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% elseif user.gender == 'female' %}<i class="ri-women-fill" aria-hidden="true"></i>{% else %}<i class="ri-genderless-fill" aria-hidden="true"></i>{% endif %}</h1>
                    <p class="profile-subtitle">{{ user.instrument ? user.instrument.title : '-' }} · {{ user.city|default('-') }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-green" aria-label="{{ 'admin.contact'|trans }}"><i class="ri-mail-fill" aria-hidden="true"></i></button>
        </div>

        <h2>{{ 'admin.current_roles_title'|trans }}</h2>
        {# No guard needed here: ROLE_USER is implicit and never has a corresponding row in `roles`, so this loop only ever contains roles that can actually be removed. #}
        <div class="role-pills">
            {% for role in roles %}
                <span class="role-badge">
                    {{ role.description|trans }}
                    <form method="post" action="{{ path('user_remove_role', {slug: user.slug, roleId: role.id}) }}" onsubmit="return confirm('{{ 'admin.confirm_remove_role'|trans({'%role%': role.description|trans})|e('js') }}');" class="btn-form">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="_token" value="{{ csrf_token('remove_role' ~ user.id ~ role.id) }}">
                        <button type="submit" class="btn btn-red" aria-label="{{ 'admin.remove_role_aria'|trans({'%role%': role.description|trans}) }}"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
                    </form>
                </span>
            {% endfor %}
        </div>

        <div class="image-rights">
            <h2>{{ 'admin.image_rights_title'|trans }}</h2>
            <div class="image-rights-row">
                <span class="image-rights-status image-rights-status--{{ user.imageRightsConsent ? 'ok' : 'unset' }}">
                    <i class="ri-camera-lens-{{ user.imageRightsConsent ? 'fill' : 'line' }}" aria-hidden="true"></i>
                    {{ (user.imageRightsConsent ? 'admin.image_rights_granted' : 'admin.image_rights_unknown')|trans }}
                </span>
                <form method="post" action="{{ path('user_toggle_image_rights', {slug: user.slug}) }}" onsubmit="return confirm('{{ (user.imageRightsConsent ? 'admin.confirm_image_rights_revoke' : 'admin.confirm_image_rights_grant')|trans({'%name%': user.fullName})|e('js') }}');" class="btn-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_image_rights' ~ user.id) }}">
                    <button type="submit" class="btn {{ user.imageRightsConsent ? 'btn-red' : 'btn-green' }}">
                        <i class="ri-{{ user.imageRightsConsent ? 'close-line' : 'check-line' }}" aria-hidden="true"></i>
                        {{ (user.imageRightsConsent ? 'admin.image_rights_revoke' : 'admin.image_rights_grant')|trans }}
                    </button>
                </form>
            </div>
        </div>

        <div class="container text-center">
            {% if 'ROLE_ADMIN' not in user.roles or 'ROLE_COMPTA' not in user.roles or 'ROLE_BINIOUFOUS' not in user.roles %}
                <h2>{{ 'admin.promote_section'|trans }}</h2>
                <div class="promote-pills">
                    {% if 'ROLE_ADMIN' not in user.roles %}
                        <form method="post" action="{{ path('create_admin', {slug: user.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_make_admin'|trans|e('js') }}');" class="btn-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_admin' ~ user.id) }}">
                            <button type="submit" class="btn btn-green" aria-label="{{ 'admin.make_admin'|trans }}"><i class="ri-add-line" aria-hidden="true"></i> {{ 'Administrator'|trans }}</button>
                        </form>
                    {% endif %}
                    {% if 'ROLE_COMPTA' not in user.roles %}
                        <form method="post" action="{{ path('create_accountant', {slug: user.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_make_accountant'|trans|e('js') }}');" class="btn-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_accountant' ~ user.id) }}">
                            <button type="submit" class="btn btn-green" aria-label="{{ 'admin.make_accountant'|trans }}"><i class="ri-add-line" aria-hidden="true"></i> {{ 'Accountant'|trans }}</button>
                        </form>
                    {% endif %}
                    {% if 'ROLE_BINIOUFOUS' not in user.roles %}
                        <form method="post" action="{{ path('create_binioufous', {slug: user.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_make_binioufous'|trans|e('js') }}');" class="btn-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_binioufous' ~ user.id) }}">
                            <button type="submit" class="btn btn-green" aria-label="{{ 'admin.make_binioufous'|trans }}"><i class="ri-add-line" aria-hidden="true"></i> {{ 'Binioufous'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
            <h2>{{ 'admin.edit_profile_section'|trans }}</h2>
            {{ form_start(form) }}
            {{ include('desk/_user_form_fields.html.twig', {form: form, user: user}) }}
            <div class="centered">
                <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
