{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullname }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="profile-header">
            <a class="btn btn-red" href="{{ path ('desk') }}" aria-label="{{ 'admin.back_to_lists'|trans }}"><i class="ri-arrow-left-line" aria-hidden="true"></i></a>
            <div class="profile-identity">
                <div class="profile-avatar-frame">
                    {% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}
                </div>
                <div>
                    <h1 class="profile-name">{{ user.fullName }} {% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% elseif user.gender == 'female' %}<i class="ri-women-fill" aria-hidden="true"></i>{% else %}<i class="ri-genderless-fill" aria-hidden="true"></i>{% endif %}</h1>
                    <p class="profile-subtitle">{{ user.instrument.title }} · {{ user.city }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-green" aria-label="{{ 'admin.contact'|trans }}"><i class="ri-mail-fill" aria-hidden="true"></i></button>
        </div>

        <div class="role-pills">
            {% for role in roles %}
                <span class="role-badge">
                    {{ role.description|trans }}
                    {% if role.title != 'ROLE_USER' %}
                        <form method="post" action="{{ path('user_remove_role', {slug: user.slug, roleId: role.id}) }}" onsubmit="return confirm('{{ 'admin.confirm_remove_role'|trans({'%role%': role.description|trans})|e('js') }}');" class="btn-form">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('remove_role' ~ user.id ~ role.id) }}">
                            <button type="submit" class="btn btn-red" aria-label="{{ 'admin.remove_role_aria'|trans({'%role%': role.description|trans}) }}"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
                        </form>
                    {% endif %}
                </span>
            {% endfor %}
        </div>

        <div class="container text-center">
            {% if 'ROLE_ADMIN' not in user.roles or 'ROLE_COMPTA' not in user.roles %}
                <h2>{{ 'admin.promote_section'|trans }}</h2>
                <div class="row centered mb-4">
                    {% if 'ROLE_ADMIN' not in user.roles %}
                        <form method="post" action="{{ path('create_admin', {slug: user.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_make_admin'|trans|e('js') }}');" class="btn-form mr-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_admin' ~ user.id) }}">
                            <button type="submit" class="btn btn-green">{{ 'admin.make_admin'|trans }}</button>
                        </form>
                    {% endif %}
                    {% if 'ROLE_COMPTA' not in user.roles %}
                        <form method="post" action="{{ path('create_accountant', {slug: user.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_make_accountant'|trans|e('js') }}');" class="btn-form ml-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_accountant' ~ user.id) }}">
                            <button type="submit" class="btn btn-green">{{ 'admin.make_accountant'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
            <h2>{{ 'admin.edit_profile_section'|trans }}</h2>
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="centered">
                <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
