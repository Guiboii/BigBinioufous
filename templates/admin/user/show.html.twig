{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullname }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row centered">
            <a class="btn btn-red" href="{{ path ('desk') }}">{{ 'admin.back_to_lists'|trans }}</a>
            <div class="col text-center">
                <div class="row card-header centered">
                    {% if user.picture == null %}
                        <i class="fas fa-portrait"></i> <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}<h1 class="ml-2">{{ user.fullName }} {% if user.gender == 'male' %}<i class="fas fa-male"></i>{% else %}<i class="fas fa-female"></i>{% endif %}</h1>
                </div>
            </div>
            <button class="btn btn-green">{{ 'admin.contact'|trans }}</button>
        </div>
        <div class="container text-center">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{ 'admin.roles'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for role in roles %}
                        <tr>
                            <td>{{ role.description }}</td>
                            <td><a href="#" class="btn btn-red"><i class="fas fa-ban"></i></a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="card card-header centered">
            <div class="row">
                <a href="{{ path('create_admin', {slug: user.slug}) }}" class="btn btn-red mr-2">{{ 'admin.make_admin'|trans }}</a>
                <a href="{{ path('create_accountant', {slug: user.slug}) }}" class="btn btn-red ml-2">{{ 'admin.make_accountant'|trans }}</a>
            </div>
            </div>
            <div class="card card-header centered">
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="centered">
                    <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
