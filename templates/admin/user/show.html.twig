{% extends 'desk/base.html.twig' %}

{% block title %}{{ user.fullname }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row centered">
            <a class="btn btn-red" href="{{ path ('desk') }}">{{ 'admin.back_to_lists'|trans }}</a>
            <div class="col text-center">
                <div class="row card-header centered">
                    {% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i> <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}<h1 class="ml-2">{{ user.fullName }} {% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% else %}<i class="ri-women-fill" aria-hidden="true"></i>{% endif %}</h1>
                </div>
            </div>
            <button type="button" class="btn btn-green">{{ 'admin.contact'|trans }}</button>
        </div>
        <div class="container text-center">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{ 'admin.roles'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for role in roles %}
                        <tr>
                            <td>{{ role.description }}</td>
                            <td><button type="button" class="btn btn-red" aria-label="{{ 'admin.remove_role_aria'|trans({'%role%': role.description}) }}"><i class="ri-forbid-line" aria-hidden="true"></i></button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="card">
                <div class="card-body row centered">
                    <a href="{{ path('create_admin', {slug: user.slug}) }}" class="btn btn-green mr-2">{{ 'admin.make_admin'|trans }}</a>
                    <a href="{{ path('create_accountant', {slug: user.slug}) }}" class="btn btn-green ml-2">{{ 'admin.make_accountant'|trans }}</a>
                </div>
            </div>
            <div class="card">
                <div class="card-body centered">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="centered">
                        <button type="submit" class="btn btn-green">{{ 'admin.validate'|trans }}</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
