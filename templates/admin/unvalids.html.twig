{% extends 'desk/base.html.twig' %}

{% block title %}{{ 'admin.validation_title'|trans }}{% endblock %}

{% block body %}

<div class="container mt-2">
    <div class="container mt-2">
        <h3>{{ 'admin.pending_requests_title'|trans }}</h3>
        <table class="table table-hover text-center">
            <thead>
                <tr>
                    <th>{{ 'Name'|trans }}</th>
                    <th>{{ 'Picture'|trans }}</th>
                    <th>{{ 'admin.wished_role'|trans }}</th>
                    <th>{{ 'Instrument'|trans }}</th>
                    <th>{{ 'Country'|trans }}</th>
                    <th>{{ 'City'|trans }}</th>
                    <th>{{ 'admin.created_at'|trans }}</th>
                    <th>{{ 'Actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in unvalids %}
                <tr>
                    <td>{% if user.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% else %}<i class="ri-women-fill" aria-hidden="true"></i>{% endif %} {{ user.fullName }}</td>
                    <td>{% if user.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i> <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ user.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ user.firstname }}">
                    {% endif %}</td>
                    <td>{{ user.wish }}</td>
                    <td>{{ user.instrument.title }}</td>
                    <td>{{ user.country }}</td>
                    <td>{{ user.city }}</td>
                    <td>{{ user.createdAt|date('d/m/Y') }}</td>
                    <td> <a href="{{ path ('user_valid', {slug: user.slug, wish: user.wish}) }}" class="btn btn-green" aria-label="{{ 'admin.validate_user_aria'|trans({'%name%': user.fullName}) }}"><i class="ri-checkbox-circle-line" aria-hidden="true"></i></a></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
