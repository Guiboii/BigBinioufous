{# Sub-navigation for the accounting space: Files, Quotes & Invoices, Treasury. Included by desk/files.html.twig (only for space == 'accounting') and by the accounting/* templates, with activeTab marking the current one. #}
<nav class="accounting-tabs" aria-label="{{ 'accounting.tabs_label'|trans }}">
    <a href="{{ path('desk_files', {space: 'accounting'}) }}" class="accounting-tab{% if activeTab == 'files' %} active{% endif %}"{% if activeTab == 'files' %} aria-current="page"{% endif %}>
        <i class="ri-folder-3-fill" aria-hidden="true"></i> {{ 'accounting.tab_files'|trans }}
    </a>
    <a href="{{ path('accounting_documents_index') }}" class="accounting-tab{% if activeTab == 'documents' %} active{% endif %}"{% if activeTab == 'documents' %} aria-current="page"{% endif %}>
        <i class="ri-file-text-fill" aria-hidden="true"></i> {{ 'accounting.tab_documents'|trans }}
    </a>
    <a href="{{ path('accounting_clients_index') }}" class="accounting-tab{% if activeTab == 'clients' %} active{% endif %}"{% if activeTab == 'clients' %} aria-current="page"{% endif %}>
        <i class="ri-team-fill" aria-hidden="true"></i> {{ 'accounting.tab_clients'|trans }}
    </a>
    <a href="{{ path('accounting_treasury_index') }}" class="accounting-tab{% if activeTab == 'treasury' %} active{% endif %}"{% if activeTab == 'treasury' %} aria-current="page"{% endif %}>
        <i class="ri-wallet-3-fill" aria-hidden="true"></i> {{ 'accounting.tab_treasury'|trans }}
    </a>
</nav>
