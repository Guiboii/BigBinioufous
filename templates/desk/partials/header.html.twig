<header>
    <nav class="navbar-admin navbar-expand-lg">
        <div class="container">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link text-yellow" href="{{ path('home') }}"><i class="ri-home-4-fill" aria-hidden="true"></i> {{ 'nav.home'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-yellow" href="{{ path('desk') }}"><i class="ri-user-settings-fill" aria-hidden="true"></i> {{ 'nav.desk'|trans }}</a>
                </li>
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_BINIOUFOUS') %}
                        <li class="nav-item">
                            <a href="{{ path('deskmusic') }}" class="nav-link text-yellow"><i class="ri-music-2-fill" aria-hidden="true"></i> {{ 'nav.songs'|trans }}</a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('event_index') }}" class="nav-link text-yellow"><i class="ri-calendar-event-fill" aria-hidden="true"></i> {{ 'nav.planning'|trans }}</a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_COMPTA') %}
                        <li class="nav-item">
                            <a href="{{ path('accountant') }}" class="nav-link text-yellow"><i class="ri-money-euro-circle-fill" aria-hidden="true"></i> {{ 'nav.accountant'|trans }}</a>
                        </li>
                    {% endif %}
                {% endif %}

                <li class="nav-item lang-switcher">
                    <a href="{{ path('app_locale', {locale: 'fr'}) }}" class="lang-link {% if app.request.locale == 'fr' %}active{% endif %}">FR</a>
                    <a href="{{ path('app_locale', {locale: 'en'}) }}" class="lang-link {% if app.request.locale == 'en' %}active{% endif %}">EN</a>
                    <a href="{{ path('app_locale', {locale: 'br'}) }}" class="lang-link {% if app.request.locale == 'br' %}active{% endif %}">BR</a>
                </li>
                <li class="nav-item ml-auto">
                    <a class="nav-link text-yellow" href="{{ path('profile') }}"><i class="ri-user-fill" aria-hidden="true"></i> {{ 'nav.profile'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-yellow" href="{{ path('logout') }}"><i class="ri-logout-box-r-fill" aria-hidden="true"></i> {{ 'nav.logout'|trans }}</a>
                </li>
            </ul>
        </div>
    </nav>
</header>
