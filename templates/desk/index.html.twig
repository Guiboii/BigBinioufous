{% extends 'desk/base.html.twig' %}

{% block title %}{{ 'nav.desk'|trans }}{% endblock %}

{% block body %}
<div class="container">
    <div class="row mt-2">
        <div class="col-1">
            {% if app.user.picture == null %}
                <a class="add-picture" href="{{ path('profile') }}">
                    <i class="ri-image-add-line" aria-hidden="true"></i>
                    <em>{{ 'desk.add_picture'|trans }}</em>
                </a>
            {% else %}
                <img src="{{ asset('uploads/pictures/' ~ app.user.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ app.user.firstname }}">
            {% endif %}
        </div>

        <div class="col">
            <div class="row ml-4">
                <h1>{{ 'desk.hello'|trans({'%nickname%': app.user.nickname}) }}</h1>
            </div>
            <div class="row centered">
                {# Retour utilisatrice 2026-08-12 : même pas encore validé,
                   l'accès à /desk (et donc /desk/profile) doit rester possible
                   pour compléter son profil en attendant. Un 1er jet
                   (UserChecker, src/Security/) bloquait la connexion
                   elle-même : retiré, remplacé par ce bandeau informatif. #}
                {% if app.user.validation == false %}
                    <div class="alert alert-info">
                        <p>{{ 'desk.pending_review'|trans }}</p>
                        <a href="{{ path('profile') }}" class="btn btn-green">{{ 'desk.pending_review_cta'|trans }}</a>
                    </div>
                {% endif %}
                {# Un seul bloc, pas un par rôle : un compte qui cumule ROLE_ADMIN
                   et ROLE_BINIOUFOUS (ex. admin qui est aussi binioufous) voyait
                   avant la section "Les Binioufous" deux fois (la boucle
                   {% for role in app.user.roles %} évaluait le if/elseif
                   séparément pour CHAQUE rôle du compte, donc ROLE_ADMIN ET
                   ROLE_BINIOUFOUS déclenchaient chacun leur branche). Priorité
                   décroissante (admin > binioufous), une seule branche rendue,
                   celle du rôle le plus "haut". Ni "membre" (ROLE_MEMBER) ni
                   "simple" (ROLE_SIMPLE) ne sont plus des rôles à part
                   (cf. ROADMAP.md "Rôles fusionnés"/"Rôles legacy et
                   implicite nettoyés", 2026-08-12) : le {% else %} final
                   couvre désormais tout compte qui ne matche aucune branche
                   au-dessus, quel que soit son historique. #}
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="col">
                        <a href="{{ path('valid') }}" class="btn btn-red">{{ 'desk.pending_count'|trans({'%count%': unvalids|length}) }}</a>
                    </div>
                    <div class="container mt-2">
                        {{ include('/desk/lists/admins.html.twig') }}
                    </div>
                    <div class="container mt-2">
                        {{ include('/desk/lists/accountants.html.twig') }}
                    </div>
                    <div class="container mt-2">
                        {{ include('/desk/lists/binioufous.html.twig') }}
                    </div>
                    <div class="container mt-2">
                        {{ include('/desk/lists/simples.html.twig') }}
                    </div>
                {% elseif is_granted('ROLE_BINIOUFOUS') %}
                    <h2>{{ 'desk.binioufous_heading'|trans }}</h2>
                    <div class="container mt-2">
                        {{ include('/desk/lists/binioufous.html.twig') }}
                    </div>
                {% else %}
                    <h2>{{ 'desk.welcome_simple'|trans }}</h2>
                    <div class="col">
                        <p>{{ 'desk.mailing_lists'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
