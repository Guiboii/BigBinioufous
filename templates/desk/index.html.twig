{% extends 'desk/base.html.twig' %}

{% block title %}{{ 'nav.desk'|trans }}{% endblock %}

{% block body %}
<div class="container">
    <div class="row mt-2">
        <div class="col-1">
            {% if app.user.picture == null %}
                <a class="btn btn-red" href="{{ path('profile') }}"><i class="fas fa-portrait"></i> <em>{{ 'desk.add_picture'|trans }}</em></a>
            {% else %}
                <img src="{{ asset('uploads/pictures/' ~ app.user.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ app.user.firstname }}">
            {% endif %}
        </div>

        <div class="col">
            <div class="row ml-4">
                <h2>{{ 'desk.hello'|trans({'%nickname%': app.user.nickname}) }}</h2>
            </div>
            <div class="row centered">
                {% if app.user.validation == false %}
                    <h3>{{ 'desk.pending_validation'|trans }}</h3>
                {% endif %}
                {% for role in app.user.roles %}
                    {% if role == 'ROLE_ADMIN' %}
                        <div class="col">
                            <a href="{{ path('valid') }}" class="btn btn-red">{{ 'desk.pending_count'|trans({'%count%': unvalids|length}) }}</a>
                        </div>
                        <div class="container mt-2">
                            {{ include('/desk/lists/admins.html.twig') }}
                        </div>
                        <div class="container mt-2">
                            {{ include('/desk/lists/accountants.html.twig') }}
                        </div>
                        <div class="container mt-2">
                            {{ include('/desk/lists/binioufous.html.twig') }}
                        </div>
                        <div class="container mt-2">
                            {{ include('/desk/lists/members.html.twig') }}
                        </div>
                        <div class="container mt-2">
                            {{ include('/desk/lists/simples.html.twig') }}
                        </div>
                    {% elseif role == 'ROLE_COMPTA' %}
                        <div class="col">
                            <a href="{{ path('accountant') }}" class="btn btn-red">{{ 'desk.accountant_link'|trans }}</a>
                        </div>
                    {% elseif role == 'ROLE_BINIOUFOUS' %}
                        <h3>{{ 'desk.binioufous_heading'|trans }}</h3>
                        <div class="container mt-2">
                            {{ include('/desk/lists/binioufous.html.twig') }}
                        </div>
                    {% elseif role == 'ROLE_MEMBER' %}
                        <div class="col">
                            <p>{{ 'desk.mailing_lists'|trans }}</p>
                        </div>
                        <div class="col">
                            <p>{{ 'desk.favorite_songs'|trans }}</p>
                        </div>
                    {% elseif role == 'ROLE_SIMPLE' %}
                        <h3>{{ 'desk.welcome_simple'|trans }}</h3>
                        <div class="col">
                            <p>{{ 'desk.mailing_lists'|trans }}</p>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
