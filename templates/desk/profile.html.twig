{% extends 'desk/base.html.twig' %}

{% block title %}{{ 'nav.profile'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="container">
            <h4>{{ 'desk.update_profile'|trans }}</h4>
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary">{{ 'desk.update_submit'|trans }}</button>
            <a class="btn btn-secondary" href="update-password">{{ 'desk.change_password'|trans }}</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
