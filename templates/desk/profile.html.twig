{% extends 'desk/base.html.twig' %}

{% block title %}{{ 'nav.profile'|trans }}{% endblock %}

{% block importmap %}{{ importmap(['app', 'avatar-preview']) }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'desk.update_profile'|trans }}</h1>
        {{ form_start(form) }}
        {{ include('desk/_user_form_fields.html.twig', {form: form, user: user}) }}
        <button type="submit" class="btn btn-green">{{ 'desk.update_submit'|trans }}</button>
        <a class="btn btn-red" href="{{ path('update-password') }}">{{ 'desk.change_password'|trans }}</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
