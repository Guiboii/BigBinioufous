<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="desk">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Binioufous!{% endblock %}</title>
        {{ importmap('app') }}
        {# Police d'affichage de la marque (Bungee), déjà chargée sur les pages
           publiques (templates/base.html.twig) : reprise ici pour les titres
           du desk/admin (body.desk h1/h2, assets/main/app.css), jamais faite
           jusqu'au 2026-08-11. #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet">
    </head>

    <body class="desk">
        {# 1er élément atteignable au clavier : reste invisible jusqu'à recevoir
           le focus (Tab), permet de sauter la navbar pour aller directement au
           contenu principal. Même pattern que templates/base.html.twig
           (.skip-link dans assets/main/app.css), jamais repris ici jusqu'à
           présent. #}
        <a class="skip-link" href="#main-content">{{ 'a11y.skip_to_content'|trans }}</a>

        {{ include('desk/partials/header.html.twig') }}

        {% for label, messages in app.flashes %}
            <div class="container">
                <div class="alert alert-{{ label }} mt-4">
                    {% for message in messages %}
                    <p>{{ message|raw }}</p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        <main id="main-content" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
    </body>

</html>
