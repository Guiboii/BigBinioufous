<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Binioufous!{% endblock %}</title>
        {{ importmap('app') }}
    </head>

    <body>

        {{ include('desk/partials/header.html.twig') }}

        {% for label, messages in app.flashes %}
            <div class="container">
                <div class="alert alert-{{ label }} mt-4">
                    {% for message in messages %}
                    <p>{{ message|raw }}</p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </body>

</html>
