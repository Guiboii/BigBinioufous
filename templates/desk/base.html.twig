<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="desk">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Binioufous!{% endblock %}</title>
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
        {# Brand display font (Bungee), already loaded on public pages: reused here for desk/admin titles (body.desk h1/h2 in app.css). #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet">
    </head>

    <body class="desk">
        {# First keyboard-reachable element: stays invisible until it receives Tab focus, letting a keyboard user skip the navbar straight to the main content. Same pattern as templates/base.html.twig. #}
        <a class="skip-link" href="#main-content">{{ 'a11y.skip_to_content'|trans }}</a>

        {{ include('desk/partials/header.html.twig') }}

        {% for label, messages in app.flashes %}
            <div class="container flash-messages">
                <div class="alert alert-{{ label }} mt-4">
                    <i class="ri-checkbox-circle-fill" aria-hidden="true"></i>
                    {% for message in messages %}
                    <p>{{ message }}</p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        <main id="main-content" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
    </body>

</html>
