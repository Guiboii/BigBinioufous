{% extends 'desk/base.html.twig' %}

{% block title %}{{ 'nav.folders'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'nav.folders'|trans }}</h1>
        <p class="desk-intro">{{ 'desk.hub_intro'|trans }}</p>

        <ul class="desk-spaces">
            {% if is_granted('ROLE_BINIOUFOUS') or is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('desk_files', {space: 'music'}) }}" class="desk-space-card">
                        <i class="ri-music-2-fill" aria-hidden="true"></i>
                        <span>{{ 'desk.space_music'|trans }}</span>
                    </a>
                </li>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('desk_files', {space: 'admin'}) }}" class="desk-space-card">
                        <i class="ri-shield-star-fill" aria-hidden="true"></i>
                        <span>{{ 'desk.space_admin'|trans }}</span>
                    </a>
                </li>
            {% endif %}
            {% if is_granted('ROLE_COMPTA') or is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('desk_files', {space: 'accounting'}) }}" class="desk-space-card">
                        <i class="ri-money-euro-circle-fill" aria-hidden="true"></i>
                        <span>{{ 'desk.space_accounting'|trans }}</span>
                    </a>
                </li>
            {% endif %}
        </ul>
    </div>
{% endblock %}
