<h3>{{ 'desk.list.admins_title'|trans }}</h3>
<table class="table table-hover text-center">
    <thead>
        <tr>
            <th>{{ 'Name'|trans }}</th>
            <th>{{ 'Picture'|trans }}</th>
            <th>{{ 'City'|trans }}</th>
            <th>{{ 'Instrument'|trans }}</th>
            <th>{{ 'Actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for admin in admins %}
            <tr>
                <td>
                    {% if admin.gender == 'male' %}
                        <i class="ri-men-fill" aria-hidden="true"></i>
                    {% else %}
                        <i class="ri-women-fill" aria-hidden="true"></i>
                    {% endif %}
                    {{ admin.fullName }}</td>
                <td>
                    {% if admin.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                        <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ admin.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ admin.firstname }}">
                    {% endif %}
                </td>
                <td>{{ admin.city }}</td>
                <td>{{ admin.instrument.title }}</td>
                <td>
                    <a href="{{ path ('user_show', {slug: admin.slug}) }}" class="btn btn-green" aria-label="{{ 'admin.edit_user_aria'|trans({'%name%': admin.fullName}) }}">
                        <i class="ri-edit-line" aria-hidden="true"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
