<h2>{{ 'desk.list.accountants_title'|trans }}</h2>
<table class="table table-hover text-center">
    <thead>
        <tr>
            <th>{{ 'Name'|trans }}</th>
            <th>{{ 'Picture'|trans }}</th>
            <th>{{ 'City'|trans }}</th>
            <th>{{ 'Instrument'|trans }}</th>
            <th>{{ 'Actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for accountant in accountants %}
            <tr>
                <td>
                    {% if accountant.gender == 'male' %}
                        <i class="ri-men-fill" aria-hidden="true"></i>
                    {% else %}
                        <i class="ri-women-fill" aria-hidden="true"></i>
                    {% endif %}
                    {{ accountant.fullName }}</td>
                <td>
                    {% if accountant.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i>
                        <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ accountant.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ accountant.firstname }}">
                    {% endif %}
                </td>
                <td>{{ accountant.city }}</td>
                <td>{{ accountant.instrument.title }}</td>
                <td>
                    <a href="{{ path ('user_show', {slug: accountant.slug}) }}" class="btn btn-green" aria-label="{{ 'admin.edit_user_aria'|trans({'%name%': accountant.fullName}) }}">
                        <i class="ri-edit-line" aria-hidden="true"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
