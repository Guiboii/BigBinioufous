<table class="table table-hover text-center">
    <h3>{{ 'desk.list.members_title'|trans }}</h3>
    <thead>
        <tr>
            <th>{{ 'Name'|trans }}</th>
            <th>{{ 'Picture'|trans }}</th>
            <th>{{ 'City'|trans }}</th>
            <th>{{ 'Instrument'|trans }}</th>
            <th>{{ 'Actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for member in members %}
            <tr>
                <td>
                    {% if member.gender == 'male' %}
                        <i class="fas fa-male"></i>
                    {% else %}
                        <i class="fas fa-female"></i>
                    {% endif %}
                    {{ member.fullName }}</td>
                <td>
                    {% if member.picture == null %}
                        <i class="fas fa-portrait"></i>
                        <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ member.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ member.firstname }}">
                    {% endif %}
                </td>
                <td>{{ member.city }}</td>
                <td>{{ member.instrument.title }}</td>
                <td>
                    <a href="{{ path ('user_show', {slug: member.slug}) }}" class="btn btn-green">
                        <i class="fas fa-user-edit"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
