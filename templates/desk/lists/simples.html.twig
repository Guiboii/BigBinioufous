<h2>{{ 'desk.list.simples_title'|trans }}</h2>
        <table class="table table-hover text-center">
            <thead>
                <tr>
                    <th>{{ 'Name'|trans }}</th>
                    <th>{{ 'Picture'|trans }}</th>
                    <th>{{ 'Country'|trans }}</th>
                    <th>{{ 'City'|trans }}</th>
                    <th>{{ 'Instrument'|trans }}</th>
                    <th>{{ 'Actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for simple in simples %}
                <tr>
                    <td>{% if simple.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% elseif simple.gender == 'female' %}<i class="ri-women-fill" aria-hidden="true"></i>{% else %}<i class="ri-genderless-fill" aria-hidden="true"></i>{% endif %} {{ simple.fullName }} </td>
                    <td>{% if simple.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i> <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ simple.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ simple.firstname }}">
                    {% endif %}</td>
                    <td>{{ simple.country|default('-') }}</td>
                    <td>{{ simple.city|default('-') }}</td>
                    <td>{{ simple.instrument ? simple.instrument.title : '-' }}</td>
                    <td>
                        <a href="{{ path ('user_show', {slug: simple.slug}) }}" class="btn btn-green" aria-label="{{ 'admin.edit_user_aria'|trans({'%name%': simple.fullName}) }}"><i class="ri-edit-line" aria-hidden="true"></i></a>
                        <form method="post" action="{{ path('user_toggle_membership', {slug: simple.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_toggle_to_member'|trans({'%name%': simple.fullName})|e('js') }}');" class="btn-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_membership' ~ simple.id) }}">
                            <button type="submit" class="btn btn-green" aria-label="{{ 'admin.toggle_to_member_aria'|trans({'%name%': simple.fullName}) }}"><i class="ri-vip-crown-2-line" aria-hidden="true"></i></button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
