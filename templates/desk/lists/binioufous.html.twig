<h2>{{ 'desk.list.binioufous_title'|trans }}</h2>
<table class="table table-hover text-center">
            <thead>
                <tr>
                    <th>{{ 'Name'|trans }}</th>
                    <th>{{ 'Picture'|trans }}</th>
                    <th>{{ 'Country'|trans }}</th>
                    <th>{{ 'City'|trans }}</th>
                    <th>{{ 'Instrument'|trans }}</th>
                    <th>{{ 'Actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for binioufou in binioufous %}
                <tr>
                    <td>{% if binioufou.gender == 'male' %}<i class="ri-men-fill" aria-hidden="true"></i>{% elseif binioufou.gender == 'female' %}<i class="ri-women-fill" aria-hidden="true"></i>{% else %}<i class="ri-genderless-fill" aria-hidden="true"></i>{% endif %} {{ binioufou.fullName }}</td>
                    <td>{% if binioufou.picture == null %}
                        <i class="ri-image-line" aria-hidden="true"></i> <em>{{ 'no picture'|trans }}</em>
                    {% else %}
                        <img src="{{ asset('uploads/pictures/' ~ binioufou.picture) }}" class="items-align-right avatar avatar-medium" alt=" Avatar de {{ binioufou.firstname }}">
                    {% endif %}</td>
                    <td>{{ binioufou.country|default('-') }}</td>
                    <td>{{ binioufou.city|default('-') }}</td>
                    <td>{{ binioufou.instrument ? binioufou.instrument.title : '-' }}</td>
                    <td>
                        <a href="{{ path ('user_show', {slug: binioufou.slug}) }}" class="btn btn-green" aria-label="{{ 'admin.edit_user_aria'|trans({'%name%': binioufou.fullName}) }}"><i class="ri-edit-line" aria-hidden="true"></i></a>
                        <form method="post" action="{{ path('user_toggle_membership', {slug: binioufou.slug}) }}" onsubmit="return confirm('{{ 'admin.confirm_toggle_to_simple'|trans({'%name%': binioufou.fullName})|e('js') }}');" class="btn-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_membership' ~ binioufou.id) }}">
                            <button type="submit" class="btn btn-red" aria-label="{{ 'admin.toggle_to_simple_aria'|trans({'%name%': binioufou.fullName}) }}"><i class="ri-vip-crown-2-fill" aria-hidden="true"></i></button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
