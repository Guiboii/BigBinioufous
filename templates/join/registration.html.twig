{% extends 'base.html.twig' %}

{% block title %}{{ 'join.registration_title'|trans }}{% endblock %}

{% block body %}

<div class="container">
    {# Titre en Bungee (même identité que le reste du site, cf. body.desk h1/
       .navbar-collapse h2 dans app.css) et avertissement regroupés dans une
       carte ink+gold (.registration-notice), cf. historique de cette page
       pour le détail des correctifs de thème/contraste. #}
    <div class="registration-header">
        <h1 class="text-green">{{ 'join.registration_heading'|trans }}</h1>
    </div>

    <div class="registration-notice">
        <i class="ri-error-warning-fill" aria-hidden="true"></i>
        <div class="registration-notice-content">
            <p class="registration-notice-warning">{{ 'join.registration_warning'|trans }}</p>
            <p>{{ 'join.registration_notice'|trans }}</p>
        </div>
    </div>

    {# .registration-form : même bug de contraste que celui déjà corrigé sur
       body.desk form (cf. assets/main/app.css) mais jamais traité ici. La
       règle générique "form { color: var(--bb-gold) }" sur fond
       --bb-green-mid ne tient que 3.63:1, sous le minimum AA (4.5:1) pour du
       texte normal. Blanc (6.82:1, AAA), même correctif que body.desk, scopé
       à cette page plutôt que rendu global. #}
    {{ form_start(form, {attr: {class: 'registration-form'}}) }}
    {# Inscription simplifiée (2026-08-12, cf. ROADMAP.md) : juste pseudo/
       email/mot de passe. Le reste du profil (identité, instrument,
       adhésion...) se complète après coup sur /desk/profile une fois le
       compte accepté. #}
    {{ form_widget(form) }}
    <div class="nav-item" >
    <button type="submit" class="submit btn btn-success">{{ 'join.submit'|trans }}</button>
    </div>
    {{ form_end(form) }}

</div>
{% endblock %}
