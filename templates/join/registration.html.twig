{% extends 'base.html.twig' %}

{% block title %}{{ 'join.registration_title'|trans }}{% endblock %}

{% block body %}

<div class="container">
    {# Title in the brand's Bungee font, warning grouped in a dark green/gold card (.registration-notice). #}
    <div class="registration-header">
        <h1 class="text-green">{{ 'join.registration_heading'|trans }}</h1>
    </div>

    <div class="registration-notice">
        <i class="ri-error-warning-fill" aria-hidden="true"></i>
        <div class="registration-notice-content">
            <p class="registration-notice-warning">{{ 'join.registration_warning'|trans }}</p>
            <p>{{ 'join.registration_notice'|trans }}</p>
        </div>
    </div>

    {# .registration-form: same contrast fix already applied to body.desk form. The generic "form" rule's gold-on-green only reaches 3.63:1, below AA; white reaches 6.82:1 (AAA), scoped to this page rather than made global. #}
    {{ form_start(form, {attr: {class: 'registration-form'}}) }}
    {# "Already a member?" is rendered separately (manual form_label/form_widget) ahead of the rest of the form, in its own detached card, so it reads as THE question to answer first. The later form_widget(form) won't re-render it: Symfony marks a field as already rendered once form_row/form_widget has been applied to it individually. #}
    <div class="already-member-step">
        {# <legend> must be the fieldset's very first child for the accessible group name to be reliable, so the hint paragraph stays after the widget, not between them. #}
        <fieldset class="already-member-fieldset">
            {{ form_label(form.claimsMembership) }}
            <div class="already-member-toggle">
                {{ form_widget(form.claimsMembership) }}
            </div>
            <p class="already-member-hint">{{ 'register.claims_membership_hint'|trans }}</p>
        </fieldset>

        {# Hidden by default, shown in JS only when "No" is selected. target="_blank"/rel="noopener": a real external navigation to HelloAsso, to avoid losing the in-progress registration form in the same tab. #}
        <div id="notMemberHelpBox" class="already-member-followup d-none">
            <i class="ri-information-fill" aria-hidden="true"></i>
            <div class="already-member-followup-content">
                <p>{{ 'register.claims_membership_not_member_hint'|trans }}</p>
                <a href="https://www.helloasso.com/associations/binioufous/adhesions/cotisations-2026-2027" class="btn btn-green" target="_blank" rel="noopener">{{ 'join.pay_subscription'|trans }}</a>
                <p class="already-member-note">{{ 'register.claims_membership_or_later'|trans }}</p>
            </div>
        </div>
    </div>

    {{ form_widget(form) }}
    <div class="nav-item" >
    <button type="submit" class="submit btn btn-success">{{ 'join.submit'|trans }}</button>
    </div>
    {{ form_end(form) }}

</div>

{# Minimal toggle, no external JS dependency: shows the HelloAsso reminder only when "No" is selected. #}
<script>
    (function () {
        var noRadio = document.getElementById('registration_claimsMembership_1');
        var notMemberHelpBox = document.getElementById('notMemberHelpBox');

        if (!noRadio || !notMemberHelpBox) {
            return;
        }

        function updateBox() {
            notMemberHelpBox.classList.toggle('d-none', !noRadio.checked);
        }

        document.querySelectorAll('input[name="registration[claimsMembership]"]').forEach(function (radio) {
            radio.addEventListener('change', updateBox);
        });
        updateBox();
    })();
</script>
{% endblock %}
