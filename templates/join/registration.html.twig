{% extends 'base.html.twig' %}

{% block title %}{{ 'join.registration_title'|trans }}{% endblock %}

{% block body %}

<div class="container">
    <div class="row ml-4 centered">
        <span class="badge badge-green mt-4">
            <h4>{{ 'join.registration_heading'|trans }}</h4>
        </span>
        <div class="text-green text-center mt-4">
            <p class="text-red">{{ 'join.registration_warning'|trans }}</p>
            <p>{{ 'join.registration_notice'|trans }}</p>
        </div>
        <div class="row">
            <button class="btn badge-red mb-4">
                <a href="https://www.helloasso.com/associations/binioufous/adhesions/cotisations" class="link red-hover">{{ 'join.pay_subscription'|trans }}</a>
            </button>
        </div>
    </div>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <div class="nav-item" >
    <button class="submit btn btn-success">{{ 'join.submit'|trans }}</button>
    </div>
    {{ form_end(form) }}

</div>

{% endblock %}
