{% extends 'base.html.twig' %}

{% block title %}{{ 'join.title'|trans }}{% endblock %}

{% block body %}

<a class="login" href="#" role="button"><h1><i class="ri-login-circle-fill" aria-hidden="true"></i> <span>{{ 'join.login_button'|trans }}</span></h1></a>
<a class="join" href="#" role="button"><h1><i class="ri-user-add-fill" aria-hidden="true"></i> <span>{{ 'join.join_button'|trans }}</span></h1></a>

<form action="{{ path('join') }}" id="loginForm" class="d-none" method="post">
         {{ include ('join/login.html.twig') }}
</form>

<form id="joinForm" class="d-none" method="post">
        {{ include ('join/launch.html.twig') }}
</form>

<div class="loading" id="js-loader"><div class="loader"></div></div>
<div class="mascotte"><canvas id="c"></canvas></div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'join']) }}{% endblock %}
