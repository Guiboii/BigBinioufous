{% extends 'base.html.twig' %}

{% block title %}{{ 'join.title'|trans }}{% endblock %}

{% block body %}

{# A single real h1 for the page, plus real <button> elements (opening a panel on this same page, not a navigation) with aria-expanded/aria-controls kept in sync by join.js on open/close. #}
<h1 class="sr-only">{{ 'join.title'|trans }}</h1>

<button type="button" class="login" aria-expanded="false" aria-controls="loginForm">
    <i class="ri-login-circle-fill" aria-hidden="true"></i> <span>{{ 'join.login_button'|trans }}</span>
</button>
{# A plain navigation link to /register, which already handles both the "already a member?" and HelloAsso membership cases. #}
<a href="{{ path('register') }}" class="join">
    <i class="ri-user-add-fill" aria-hidden="true"></i> <span>{{ 'join.join_button'|trans }}</span>
</a>

{{ include('components/form-dialog.html.twig', {
    id: 'loginForm',
    action: path('join'),
    title: 'join.login_title',
    content: include('join/login.html.twig'),
}) }}

<div class="loading" id="js-loader" aria-hidden="true"><div class="loader"></div></div>
<div class="mascotte" aria-hidden="true"><canvas id="c"></canvas></div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'join']) }}{% endblock %}
