{# Generic login form fragment, reusable anywhere. Unlike join/login.html.twig, this fragment never shows an error message, since that only makes sense on /join after a failed login attempt. #}

<div class="form-group">
    <label for="login-email">{{ 'Email'|trans }}</label>
    <input
        type="email"
        name="_username"
        id="login-email"
        class="form-control"
        placeholder="{{ 'join.email_placeholder'|trans }}"
        autocomplete="email"
        required
    >
</div>

<div class="form-group">
    <label for="login-password">{{ 'Password'|trans }}</label>
    <input
        type="password"
        name="_password"
        id="login-password"
        placeholder="{{ 'join.password_placeholder'|trans }}"
        class="form-control"
        autocomplete="current-password"
        required
    >
</div>

<div class="form-group">
    <button type="submit" class="btn btn-success">{{ 'join.login_submit'|trans }}</button>
</div>
