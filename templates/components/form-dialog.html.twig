{#
Reusable dialog popup with a form.

Params:
  - id: unique form identifier (required)
  - action: submission URL (optional, defaults to the current path)
  - title: translation key for the title (required)
  - content: form content HTML (required)

Accessibility:
  - role="dialog" + aria-modal="true" exposes the role to screen readers
  - aria-labelledby ties the form to its h2 title
  - aria-live="polite" on errors announces messages to screen readers
  - accessible close button with aria-label
#}
<form
    {% if action is defined and action %}action="{{ action }}"{% endif %}
    id="{{ id }}"
    class="d-none"
    method="post"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ id }}-title"
>
    <div class="dialog-header">
        <h2 id="{{ id }}-title">{{ title|trans }}</h2>
        <button type="button" class="close" data-close aria-label="{{ 'common.close'|trans }}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="dialog-body">
        {{ content|raw }}
    </div>
</form>
